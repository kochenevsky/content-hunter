# ===========================================
# Content Hunter - Environment Variables
# ===========================================

# Supabase PostgreSQL
# Рекомендуется: Connection pooler (Session или Transaction) — меньше проблем с IPv6 (EHOSTUNREACH).
# Supabase Dashboard → Settings → Database → Connection string → Connection pooling
# Прямое: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URI=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Payload CMS Secret (обязательно для админки и seed)
# Сгенерировать: openssl rand -base64 32
# После настройки .env.local создайте первого админа: pnpm run seed:admin
# Логин: admin@contenthunter.ru  Пароль: Admin123!
PAYLOAD_SECRET=your-super-secret-key-minimum-32-characters

# Site URL
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===========================================
# Optional: Integrations
# ===========================================

# AmoCRM
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (отправка заявок с формы контактов на email)
# Ключ: https://resend.com/api-keys
RESEND_API_KEY=
# Опционально: свой домен (иначе используется onboarding@resend.dev)
# EMAIL_FROM=Content Hunter <заявки@ваш-домен.ru>

# Supabase (direct access, optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
