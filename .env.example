# ===========================================
# Content Hunter - Environment Variables
# ===========================================

# Supabase PostgreSQL (обязательно для Vercel: без этого /admin и страницы с CMS отдают 500)
# Используйте Connection pooler → Session mode → port 5432 (IPv4, стабильно на Vercel).
# Supabase Dashboard → Settings → Database → Connection string → Connection pooling
# Session (5432): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URI=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Payload CMS Secret (обязательно для админки и для Vercel)
# Сгенерировать: openssl rand -base64 32
# Vercel: Settings → Environment Variables → DATABASE_URI, PAYLOAD_SECRET, BLOB_READ_WRITE_TOKEN
PAYLOAD_SECRET=your-super-secret-key-minimum-32-characters

# Vercel Blob (для загрузки медиа в админке; в Vercel: Storage → Create → Blob → BLOB_READ_WRITE_TOKEN)
BLOB_READ_WRITE_TOKEN=

# Site URL
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===========================================
# Optional: Integrations
# ===========================================

# AmoCRM
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (отправка заявок с формы контактов на email)
# Ключ: https://resend.com/api-keys
RESEND_API_KEY=
# Опционально: свой домен (иначе используется onboarding@resend.dev)
# EMAIL_FROM=Content Hunter <заявки@ваш-домен.ru>

# Supabase (direct access, optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
